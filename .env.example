# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (PostgreSQL 16)
# Local example:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trello
# Free cloud example (Neon / Supabase / Render / Aiven):
# DATABASE_URL=postgres://user:password@ep-sample.neon.tech/trello?sslmode=require

# Redis Configuration (Pub/Sub Adapter)
# Local example:
REDIS_URL=redis://localhost:6379
# Free cloud example (Upstash / Redis Cloud):
# REDIS_URL=rediss://default:yourpassword@your-endpoint.upstash.io:6379
